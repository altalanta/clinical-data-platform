# Multi-stage build for Clinical Data Platform Analytics
FROM python:3.11-slim as builder

# Build arguments
ARG VERSION=dev
ARG BUILD_DATE
ARG VCS_REF

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN pip install poetry

# Set working directory
WORKDIR /app

# Copy poetry configuration
COPY clinical-data-platform/pyproject.toml clinical-data-platform/poetry.lock ./

# Configure poetry and install dependencies including dbt
RUN poetry config virtualenvs.create false \
    && poetry install --only=main --no-dev

# Install dbt separately to ensure compatibility
RUN pip install dbt-duckdb

# Runtime stage
FROM python:3.11-slim as runtime

# Labels for container metadata
LABEL org.opencontainers.image.title="Clinical Data Platform Analytics"
LABEL org.opencontainers.image.description="dbt-based analytics and transformations"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${VCS_REF}"
LABEL org.opencontainers.image.vendor="Clinical Data Platform Team"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.source="https://github.com/altalanta/clinical-data-platform"

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Set working directory
WORKDIR /app

# Copy application code and dbt project
COPY clinical-data-platform/src ./src
COPY clinical-data-platform/pyproject.toml ./
COPY analytics/ ./analytics/

# Create directories for dbt operations
RUN mkdir -p /app/logs /app/target /app/dbt_packages \
    && chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Environment variables
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV DBT_PROFILES_DIR=/app/analytics/dbt
ENV DBT_PROJECT_DIR=/app/analytics/dbt

# Health check
HEALTHCHECK --interval=60s --timeout=30s --start-period=180s --retries=3 \
    CMD dbt --version || exit 1

# Default command
CMD ["python", "-m", "clinical_platform.cli.transform"]